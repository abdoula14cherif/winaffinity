{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/inscription", "destination": "/inscription.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/travail", "destination": "/travail.html" },
    { "source": "/lancer", "destination": "/lancer.html" },
    { "source": "/retirer", "destination": "/retirer.html" },
    { "source": "/parrainage", "destination": "/parrainage.html" },
    { "source": "/missions", "destination": "/missions.html" },
    { "source": "/moi", "destination": "/moi.html" },
    { "source": "/ticket", "destination": "/ticket.html" },
    { "source": "/classement", "destination": "/classement.html" },
    { "source": "/actualites", "destination": "/actualites.html" },
    { "source": "/notifications", "destination": "/notifications.html" },
    { "source": "/entreprise", "destination": "/entreprise.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/roue", "destination": "/roue.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}